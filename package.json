{
  "name": "code-archaeologist",
  "version": "1.0.0",
  "description": "Evidence-driven binary archaeology API for legacy Windows PE executables",
  "main": "dist/app/server.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/app/server.js",
    "dev": "ts-node --project tsconfig.json src/app/server.ts",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "binary",
    "archaeology",
    "pe",
    "ghidra",
    "reverse-engineering"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@types/dotenv": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "p-queue": "^6.6.2",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
