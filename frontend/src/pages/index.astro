---
import Background3D from '../components/Background3D.astro';
---
<html lang="en">
<head>
<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>Code Archaeologist - XalapaTeam</title>
<style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: white;
      overflow-x: hidden;
    }
    main {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      height: 100vh;
      padding-bottom: 15vh;
      box-sizing: border-box;
      pointer-events: none;
    }
    @media (max-width: 768px) {
      main {
        padding-bottom: 5vh;
        justify-content: center;
      }
      h1 {
        font-size: 1.5rem !important;
      }
      .panel {
        padding: 1.5rem;
      }
    }
    .panel-wrapper {
      position: relative;
      width: 90%;
      max-width: 550px;
      border-radius: 14px;
      padding: 3px;
      overflow: hidden;
      pointer-events: auto;
      box-shadow: 0 0 30px rgba(0, 216, 255, 0.3);
    }
    .panel-wrapper::before {
      content: "";
      position: absolute;
      top: -50%; left: -50%; width: 200%; height: 200%;
      background: conic-gradient(from 0deg, transparent 70%, #00d8ff 100%);
      animation: rotateBorder 6s linear infinite;
      z-index: -1;
    }
    @keyframes rotateBorder {
      0%   { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .panel {
      background: rgba(10, 10, 10, 0.9);
      backdrop-filter: blur(15px);
      border-radius: 12px;
      padding: 2.5rem;
      text-align: center;
      height: 100%;
      box-sizing: border-box;
    }
    h1 {
      margin-top: 0;
      font-weight: 300;
      letter-spacing: 3px;
      font-size: 2.2rem;
    }
    p.subtitle {
      color: #ccc;
      font-size: 1.1rem;
      margin-bottom: 2.5rem;
      line-height: 1.5;
    }
    .upload-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background: transparent;
      color: #00d8ff;
      border: 2px solid #00d8ff;
      padding: 1rem 2rem;
      border-radius: 8px;
      cursor: pointer;
      font-size: 1.2rem;
      font-weight: bold;
      transition: all 0.2s;
    }
    .upload-btn:hover {
      background: #00d8ff;
      color: #000;
      box-shadow: 0 0 20px #00d8ff;
    }
    #file-input {
      display: none;
    }
    .status-text {
      margin-top: 1.5rem;
      font-size: 1.1rem;
      color: #bbb;
      min-height: 3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
    @keyframes spin {
      100% { transform: rotate(360deg); }
    }
    .neon-spinner {
      width: 24px;
      height: 24px;
      border: 3px solid rgba(0, 216, 255, 0.1);
      border-top-color: #00d8ff;
      border-radius: 50%;
      animation: spin 2s linear infinite;
      box-shadow: 0 0 10px rgba(0, 216, 255, 0.6);
    }
    #bg-word {
      position: absolute;
      top: 55%;
      font-size: clamp(1rem, 2vw, 2rem);
      font-weight: 800;
      color: rgba(255, 255, 255, 0.4);
      -webkit-text-stroke: 1px #00d8ff;
      text-shadow: 0 0 15px rgba(0, 216, 255, 0.8);
      opacity: 0;
      z-index: 0;
      pointer-events: none;
      white-space: nowrap;
      transition: opacity 1s ease-in-out;
      letter-spacing: 5px;
      text-transform: uppercase;
    }
  </style>
</head>
<body>
<Background3D />
<main>
<div id="bg-word" style="left: 5%;">REVERSE-ENGINEERING</div>
<div class="panel-wrapper" style="z-index: 1;">
<div class="panel">
<h1>BINARY ANALYSIS</h1>
<p class="subtitle">Upload legacy Windows PE executables for static analysis.</p>
<label class="upload-btn" for="file-input" id="upload-label">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4">
</path>
<polyline points="17 8 12 3 7 8">
</polyline>
<line x1="12" y1="3" x2="12" y2="15">
</line>
</svg>
          Select Binary
        </label>
<input type="file" id="file-input" />
<button class="upload-btn" id="results-btn" style="display: none; border-color: #ff0055; color: #ff0055;">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<path d="M3 3v18h18">
</path>
<path d="M18 9l-5 5-4-4-5 5">
</path>
</svg>
          View Results
        </button>
<div class="status-text" id="status-display">Ready for upload.</div>
</div>
</div>
</main>
<script>
    // ── Background word rotation ──────────────────────────────────────────
    const words = [
      "REVERSE-ENGINEERING",
      "DECOMPILATION",
      "ANALYSIS",
      "FORENSICS",
      "EXTRACTION",
      "INFERENCE",
      "RECONSTRUCTION",
      "MODERNIZATION",
      "INSPECTION",
      "DISCOVERY"
    ];
    let wordIndex = 0;
    const wordEl = document.getElementById('bg-word');

    setTimeout(() => { wordEl.style.opacity = '0.3'; }, 500);

    setInterval(() => {
      wordEl.style.opacity = '0';
      setTimeout(() => {
        wordIndex = (wordIndex + 1) % words.length;
        wordEl.textContent = words[wordIndex];
        if (wordIndex % 2 === 0) {
          wordEl.style.left = '5%';
          wordEl.style.right = 'auto';
        } else {
          wordEl.style.left = 'auto';
          wordEl.style.right = '5%';
        }
        wordEl.style.opacity = '0.4';
      }, 1000);
    }, 4000);

    // ── Upload & polling logic ────────────────────────────────────────────
    const fileInput = document.getElementById('file-input');
    const statusDisplay = document.getElementById('status-display');
    const uploadLabel = document.getElementById('upload-label');
    const resultsBtn = document.getElementById('results-btn');

    const setStatus = (text, isLoading = false) => {
      statusDisplay.innerHTML = isLoading
        ? `<div class="neon-spinner">
</div>
<span>${text}</span>`
        : `<span>${text}</span>`;
    };

    fileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      setStatus(`Uploading ${file.name}...`, true);
      uploadLabel.style.display = 'none';
      resultsBtn.style.display = 'none';

      try {
        const formData = new FormData();
        formData.append("file", file);

        const res = await fetch("/api/v1/analyses/binary", {
          method: "POST",
          body: formData
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error?.message || data.message || "Upload failed");
        }

        pollStatus(data.id);
      } catch (err) {
        setStatus(`Error: ${err.message}`);
        uploadLabel.style.display = 'inline-flex';
      }
    });

    async function pollStatus(id) {
      try {
        const res = await fetch(`/api/v1/analyses/${id}`);
        if (!res.ok) throw new Error("Failed to fetch status");

        const data = await res.json();
        setStatus(`Status: ${data.status.toUpperCase()}`, true);

        if (['completed', 'partial', 'failed'].includes(data.status)) {
          setStatus(`Analysis finished with status: ${data.status}`);

          if (data.status === 'failed') {
            uploadLabel.style.display = 'inline-flex';
            uploadLabel.innerHTML = 'Try Another Binary';
          } else {
            resultsBtn.style.display = 'inline-flex';
            resultsBtn.onclick = () => {
              window.location.href = `/results?id=${id}`;
            };
          }
          return;
        }

        setTimeout(() => pollStatus(id), 2000);
      } catch (err) {
        setStatus("Error polling status.");
        uploadLabel.style.display = 'inline-flex';
      }
    }
  </script>
</body>
</html>
