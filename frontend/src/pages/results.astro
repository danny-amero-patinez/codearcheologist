---
---
<html lang="en">
<head>
<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Analysis Results — Code Archaeologist</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  html { background: #0a0a0a; }
  body {
    margin: 0;
    background: #0a0a0a;
    font-family: system-ui, "Segoe UI", sans-serif;
    color: #e6edf3;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── App header ──────────────────────────────────────────────── */
  .app-header {
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-shrink: 0;
  }
  .app-header-left { display: flex; flex-direction: column; gap: 0.15rem; }
  .app-name    { font-size: 1.1rem; font-weight: 600; color: #e6edf3; }
  .app-tagline { font-size: 0.78rem; color: #57606a; }
  .app-credit  { font-size: 0.78rem; color: #57606a; }

  /* ── Toolbar ─────────────────────────────────────────────────── */
  .toolbar {
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    flex-shrink: 0;
  }

  .nav-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #29d9ff;
    text-decoration: none;
    font-size: 0.85rem;
    transition: opacity 0.15s;
    margin-right: auto;
  }
  .nav-back:hover { opacity: 0.7; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    border: 1px solid rgba(41,217,255,0.4);
    color: #29d9ff;
    padding: 0.45rem 1.1rem;
    border-radius: 5px;
    cursor: pointer;
    font-size: 0.83rem;
    font-family: inherit;
    font-weight: 500;
    transition: border-color 0.15s, background 0.15s;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn:hover {
    border-color: #29d9ff;
    background: rgba(41,217,255,0.07);
  }
  .btn:disabled { opacity: 0.4; cursor: default; }

  /* ── Report frame area ───────────────────────────────────────── */
  .report-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  #report-frame {
    flex: 1;
    width: 100%;
    border: none;
    display: block;
    /* minimum height so the loading state is visible on short viewports */
    min-height: 400px;
  }

  /* ── States rendered inside the frame area before iframe loads ── */
  .state-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
    color: #57606a;
    font-size: 0.9rem;
    gap: 1rem;
  }
  .state-box.error { color: #f85149; }

  @keyframes spin { 100% { transform: rotate(360deg); } }
  .spinner {
    width: 26px; height: 26px;
    border: 2px solid rgba(41,217,255,0.15);
    border-top-color: #29d9ff;
    border-radius: 50%;
    animation: spin 1.4s linear infinite;
  }

  @media (max-width: 640px) {
    .app-credit { display: none; }
    .toolbar { padding: 0.75rem 1rem; }
  }
</style>
</head>
<body>

<header class="app-header">
  <div class="app-header-left">
    <span class="app-name">Code Archaeologist</span>
    <span class="app-tagline">Evidence-driven binary archaeology</span>
  </div>
  <span class="app-credit">Built by Xalapa Team</span>
</header>

<div class="toolbar">
  <a href="/" class="nav-back">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
    </svg>
    Analyze another binary
  </a>

  <button class="btn" id="dl-html" disabled>
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
    </svg>
    Download HTML Report
  </button>

  <button class="btn" id="dl-json" disabled>
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
    </svg>
    Download JSON
  </button>
</div>

<div class="report-area" id="report-area">
  <div class="state-box" id="state-box">
    <div class="spinner"></div>
    <span>Loading report…</span>
  </div>
  <!-- iframe injected by JS once HTML is fetched -->
</div>

<script>
  const id = new URLSearchParams(window.location.search).get('id');
  const area      = document.getElementById('report-area');
  const stateBox  = document.getElementById('state-box');
  const dlHtml    = document.getElementById('dl-html');
  const dlJson    = document.getElementById('dl-json');

  function showError(msg) {
    stateBox.className = 'state-box error';
    stateBox.innerHTML = `<p style="margin:0;font-weight:500">${msg}</p>
      <a href="/" style="color:#29d9ff;font-size:0.82rem">← Back to Upload</a>`;
  }

  if (!id) {
    showError('No analysis ID — navigate here from the upload page.');
  } else {
    // Wire download buttons now that we have an id
    dlHtml.disabled = false;
    dlJson.disabled = false;

    dlHtml.addEventListener('click', () => {
      let count = parseInt(localStorage.getItem('reportCounter') || '0', 10) + 1;
      localStorage.setItem('reportCounter', String(count));
      const a = document.createElement('a');
      a.href = `/api/v1/analyses/${id}/report?format=html`;
      a.download = `Analysis_Report_${count}.html`;
      a.style.display = 'none';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });

    dlJson.addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = `/api/v1/analyses/${id}/report?format=json`;
      a.download = `analysis_${id}.json`;
      a.style.display = 'none';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });

    // Fetch the HTML report and display it in an isolated srcdoc iframe
    fetch(`/api/v1/analyses/${id}/report?format=html`)
      .then(res => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.text();
      })
      .then(html => {
        stateBox.remove();

        // Force dark theme in the embedded report by injecting data-theme="dark"
        // on the <html> element. This activates the html[data-theme="dark"] rule
        // in the report CSS without changing the downloaded file's standalone behaviour.
        const darkHtml = html.replace(/(<html\b[^>]*)>/i, '$1 data-theme="dark">');

        const frame = document.createElement('iframe');
        frame.id = 'report-frame';
        frame.setAttribute('sandbox', 'allow-same-origin');
        frame.setAttribute('title', 'Analysis Report');
        // srcdoc keeps the report CSS fully isolated from the app shell
        frame.srcdoc = darkHtml;

        // Expand iframe to fit its content after it loads
        frame.addEventListener('load', () => {
          try {
            const h = frame.contentDocument?.documentElement?.scrollHeight;
            if (h && h > 0) frame.style.height = h + 'px';
          } catch (_) { /* cross-origin guard — srcdoc is same-origin, but guard anyway */ }
        });

        area.appendChild(frame);
      })
      .catch(err => {
        showError(`Failed to load report: ${err.message}`);
      });
  }
</script>
</body>
</html>
