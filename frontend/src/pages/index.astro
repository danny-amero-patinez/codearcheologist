---
/**
 * index.astro — Upload page (route: /)
 * ─────────────────────────────────────────────────────────────────────────────
 * Entry point of the Code Archaeologist application.
 *
 * Features:
 *   1. File upload — hidden <input type="file">, triggered via styled <label>
 *   2. Upload → POST /api/v1/analyses/binary (multipart/form-data, field "file")
 *   3. Status polling — GET /api/v1/analyses/:id every 2000 ms until terminal
 *      status: "completed" | "partial" | "failed"
 *   4. On success → "View Results" button navigates to /results?id=<analysisId>
 */
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>Code Archaeologist — Static Binary Analysis</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    html {
      background: #0a0a0a;
    }
    body {
      margin: 0;
      background: #0a0a0a;
      font-family: system-ui, "Segoe UI", sans-serif;
      color: #e6edf3;
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* ── App shell ─────────────────────────────────────────────────────── */
    .app-header {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.25rem 2rem;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .app-header-left { display: flex; flex-direction: column; gap: 0.15rem; }
    .app-name {
      font-size: 1.1rem;
      font-weight: 600;
      color: #e6edf3;
      letter-spacing: 0.01em;
    }
    .app-tagline {
      font-size: 0.78rem;
      color: #57606a;
    }
    .app-credit {
      font-size: 0.78rem;
      color: #57606a;
    }

    /* ── Main content ───────────────────────────────────────────────────── */
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem 3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero {
      text-align: center;
      margin-bottom: 3rem;
      max-width: 640px;
    }
    .hero h1 {
      font-size: 2.4rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin: 0 0 1rem;
      color: #e6edf3;
    }
    .hero h1 span {
      color: #29d9ff;
    }
    .hero p {
      font-size: 1.05rem;
      color: #8b949e;
      line-height: 1.65;
      margin: 0;
    }

    /* ── Upload card ────────────────────────────────────────────────────── */
    .upload-card {
      width: 100%;
      max-width: 560px;
      background: #161b22;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      padding: 2.5rem 2rem;
      text-align: center;
    }

    .drop-zone-label {
      font-size: 0.88rem;
      color: #57606a;
      margin-bottom: 1.5rem;
    }
    .drop-zone-label strong {
      display: block;
      font-size: 1.05rem;
      color: #8b949e;
      font-weight: 400;
      margin-bottom: 0.25rem;
    }

    /* Primary upload button */
    .upload-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: #29d9ff;
      color: #0a0a0a;
      border: none;
      padding: 0.75rem 2rem;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.95rem;
      font-weight: 600;
      font-family: inherit;
      transition: background 0.15s, opacity 0.15s;
      text-decoration: none;
    }
    .upload-btn:hover {
      background: #50e3ff;
    }

    /* Results / try again button */
    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: transparent;
      color: #29d9ff;
      border: 1px solid rgba(41,217,255,0.5);
      padding: 0.75rem 2rem;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.95rem;
      font-weight: 600;
      font-family: inherit;
      transition: border-color 0.15s, background 0.15s;
    }
    .action-btn:hover {
      border-color: #29d9ff;
      background: rgba(41,217,255,0.07);
    }

    #file-input { display: none; }

    .filename-display {
      margin-top: 1rem;
      font-size: 0.85rem;
      color: #8b949e;
      font-family: "Cascadia Code", Consolas, monospace;
      min-height: 1.4em;
    }

    /* Status / progress area */
    .status-text {
      margin-top: 1.5rem;
      font-size: 0.9rem;
      color: #8b949e;
      min-height: 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
    }

    /* Phase progress list shown during polling */
    .phase-list {
      width: 100%;
      max-width: 340px;
      text-align: left;
      margin-top: 0.5rem;
    }
    .phase-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.22rem 0;
      font-size: 0.82rem;
      color: #8b949e;
    }
    .phase-row.completed { color: #3fb950; }
    .phase-row.active    { color: #29d9ff; }
    .phase-row.pending   { color: #484f58; }
    .phase-row.failed    { color: #f85149; }
    .phase-icon { width: 14px; text-align: center; flex-shrink: 0; font-style: normal; }

    /* Running-phase indicator shown above the phase list during analysis */
    .phase-running-indicator {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: #29d9ff;
      margin-bottom: 0.6rem;
    }

    @keyframes spin { 100% { transform: rotate(360deg); } }
    .neon-spinner {
      width: 20px; height: 20px;
      border: 2px solid rgba(41,217,255,0.15);
      border-top-color: #29d9ff;
      border-radius: 50%;
      animation: spin 1.5s linear infinite;
      flex-shrink: 0;
    }

    /* ── Static analysis note ───────────────────────────────────────────── */
    .static-note {
      margin-top: 1.25rem;
      font-size: 0.78rem;
      color: #484f58;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      justify-content: center;
    }
    .static-note::before {
      content: "•";
      color: #3fb950;
    }

    /* ── How it works steps ─────────────────────────────────────────────── */
    .steps {
      width: 100%;
      max-width: 560px;
      margin-top: 3.5rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .step {
      padding: 1.2rem 1rem;
      background: #161b22;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 8px;
    }
    .step-num {
      font-size: 0.72rem;
      font-family: "Cascadia Code", Consolas, monospace;
      color: #29d9ff;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .step h3 {
      font-size: 0.88rem;
      font-weight: 600;
      color: #c9d1d9;
      margin: 0 0 0.4rem;
    }
    .step p {
      font-size: 0.78rem;
      color: #57606a;
      margin: 0;
      line-height: 1.5;
    }

    /* ── Responsive ─────────────────────────────────────────────────────── */
    @media (max-width: 600px) {
      main { padding: 2.5rem 1rem 2rem; }
      .hero h1 { font-size: 1.7rem; }
      .app-header { flex-direction: column; gap: 0.25rem; }
      .app-credit { display: none; }
      .steps { grid-template-columns: 1fr; }
      .upload-card { padding: 1.75rem 1.25rem; }
    }
  </style>
</head>
<body>

  <!-- App header -->
  <header class="app-header">
    <div class="app-header-left">
      <span class="app-name">Code Archaeologist</span>
      <span class="app-tagline">Evidence-driven binary archaeology</span>
    </div>
    <span class="app-credit">Built by Xalapa Team</span>
  </header>

  <main>
    <!-- Hero -->
    <div class="hero">
      <h1>Understand legacy software<br/><span>when the source is gone</span></h1>
      <p>Upload a Windows PE executable and reconstruct evidence-backed responsibilities,
         dependencies, unknowns, and modernization guidance.</p>
    </div>

    <!-- Upload card -->
    <div class="upload-card">
      <div class="drop-zone-label">
        <strong>Drop a binary here, or</strong>
        Windows PE executables (.exe, .dll)
      </div>

      <label class="upload-btn" for="file-input" id="upload-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        Select Binary
      </label>

      <input type="file" id="file-input" />

      <div class="filename-display" id="filename-display"></div>

      <button class="action-btn" id="results-btn" style="display:none; margin-top:1rem">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18"></path>
          <path d="M18 9l-5 5-4-4-5 5"></path>
        </svg>
        View Results
      </button>

      <div class="status-text" id="status-display"></div>

      <div class="static-note">Static analysis only &nbsp;·&nbsp; Uploaded binaries are never executed</div>
    </div>

    <!-- How it works -->
    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <h3>Extract Evidence</h3>
        <p>PE metadata, strings, and binary structure</p>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <h3>Analyze Functions</h3>
        <p>Ghidra functions, APIs, references, and pseudocode</p>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <h3>Reconstruct</h3>
        <p>Responsibilities, unknowns, and modernization guidance</p>
      </div>
    </div>
  </main>

  <script>
    // ── Upload & polling logic ────────────────────────────────────────────────
    const fileInput      = document.getElementById('file-input')      as HTMLInputElement;
    const statusDisplay  = document.getElementById('status-display')  as HTMLElement;
    const filenameDisplay = document.getElementById('filename-display') as HTMLElement;
    const uploadLabel    = document.getElementById('upload-label')    as HTMLElement;
    const resultsBtn     = document.getElementById('results-btn')     as HTMLButtonElement;

    // Keys match the exact phase IDs emitted by the backend pipeline.
    const PHASES = [
      { key: 'intake',          label: 'Intake' },
      { key: 'profiling',       label: 'Profiling' },
      { key: 'extracting',      label: 'Evidence Extraction' },
      { key: 'ghidra-analysis', label: 'Ghidra Analysis' },
      { key: 'correlating',     label: 'Correlation' },
      { key: 'inferring',       label: 'Inference' },
      { key: 'reconstructing',  label: 'Reconstruction' },
      { key: 'reporting',       label: 'Reporting' },
    ];

    // Map backend phase keys to friendly display labels
    const PHASE_LABELS: Record<string, string> = Object.fromEntries(
      PHASES.map(({ key, label }) => [key, label])
    );

    function setStatus(html: string) {
      statusDisplay.innerHTML = html;
    }

    function renderPhaseProgress(phases: Array<{phase:string, status:string}>) {
      const phaseMap = new Map(phases.map(p => [p.phase, p.status]));

      // Find the currently running phase label for the working indicator
      const runningPhase = phases.find(p => p.status === 'running');
      const runningLabel = runningPhase ? (PHASE_LABELS[runningPhase.phase] ?? runningPhase.phase) : null;

      const rows = PHASES.map(({ key, label }) => {
        const status = phaseMap.get(key) ?? 'pending';
        const cls = status === 'completed' ? 'completed'
          : status === 'running' ? 'active'
          : status === 'failed' ? 'failed'
          : 'pending';
        const icon = status === 'completed' ? '✓'
          : status === 'running' ? '⟳'
          : status === 'failed' ? '✗'
          : '○';
        return `<div class="phase-row ${cls}"><span class="phase-icon">${icon}</span><span>${label}</span></div>`;
      }).join('');

      const indicator = runningLabel
        ? `<div class="phase-running-indicator"><span class="neon-spinner" style="width:12px;height:12px;border-width:2px"></span><span>⟳ ${runningLabel} in progress…</span></div>`
        : '';

      return `${indicator}<div class="phase-list">${rows}</div>`;
    }

    fileInput.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      filenameDisplay.textContent = file.name;
      setStatus(`<div class="neon-spinner"></div><span>Uploading…</span>`);
      uploadLabel.style.display = 'none';
      resultsBtn.style.display  = 'none';

      try {
        const formData = new FormData();
        formData.append('file', file);

        const res  = await fetch('/api/v1/analyses/binary', { method: 'POST', body: formData });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error?.message || data.message || 'Upload failed');
        }

        pollStatus(data.analysis.id);

      } catch (err: any) {
        setStatus(`<span style="color:#f85149">Error: ${err.message}</span>`);
        uploadLabel.style.display = 'inline-flex';
      }
    });

    async function pollStatus(id: string) {
      try {
        const res  = await fetch(`/api/v1/analyses/${id}`);
        if (!res.ok) throw new Error('Failed to fetch status');

        const data   = await res.json();
        const status = data.analysis?.status ?? data.status;
        const phases: Array<{phase:string, status:string}> = data.analysis?.phases ?? [];

        const isTerminal = ['completed', 'partial', 'failed'].includes(status);

        if (isTerminal) {
          // On terminal status: no spinner, render final phase states
          const finalPhaseHtml = phases.length > 0 ? renderPhaseProgress(phases) : '';
          if (status === 'failed') {
            setStatus(`<span style="color:#f85149">Analysis failed.</span>${finalPhaseHtml}`);
            uploadLabel.textContent = 'Try Another Binary';
            uploadLabel.style.display = 'inline-flex';
          } else {
            setStatus(`<span style="color:#3fb950">Analysis complete.</span>${finalPhaseHtml}`);
            resultsBtn.style.display = 'inline-flex';
            resultsBtn.onclick = () => { window.location.href = `/results?id=${id}`; };
          }
          return;
        }

        // Non-terminal: renderPhaseProgress includes the spinner + running-phase indicator
        const phaseHtml = phases.length > 0 ? renderPhaseProgress(phases) : `<div class="neon-spinner"></div>`;
        setStatus(phaseHtml);

        setTimeout(() => pollStatus(id), 2000);

      } catch (err) {
        setStatus('<span style="color:#f85149">Error polling status.</span>');
        uploadLabel.style.display = 'inline-flex';
      }
    }
  </script>
</body>
</html>
